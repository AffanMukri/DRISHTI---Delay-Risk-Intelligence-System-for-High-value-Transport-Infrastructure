VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_ENABLE_SIGNUP=true
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_DATA_SOURCE=backend
VITE_ENABLE_MOCK_FALLBACK=false

# Optional local-only demo mode. Active only with Vite development mode and
# VITE_DATA_SOURCE=mock. Never use this mode for deployed environments.
VITE_DEMO_AUTH=false
VITE_DEMO_ADMIN_EMAIL=admin@dhristi.local
VITE_DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
VITE_DEMO_EXECUTIVE_EMAIL=executive@dhristi.local
VITE_DEMO_EXECUTIVE_PASSWORD=replace-with-a-local-demo-password
VITE_DEMO_OFFICER_EMAIL=officer@dhristi.local
VITE_DEMO_OFFICER_PASSWORD=replace-with-a-local-demo-password
VITE_DEMO_ANALYST_EMAIL=analyst@dhristi.local
VITE_DEMO_ANALYST_PASSWORD=replace-with-a-local-demo-password

# Server/CLI only. Never prefix these with VITE_ or ship them to the browser.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-cli-access-token
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Hybrid risk scoring (server only). Defaults preserve the original rule score
# as the primary signal; each weight group must sum to 1.0.
RISK_ENSEMBLE_RULE_WEIGHT=0.50
RISK_ENSEMBLE_STATISTICAL_WEIGHT=0.25
RISK_ENSEMBLE_ML_WEIGHT=0.25
RISK_RULE_PROGRESS_WEIGHT=0.25
RISK_RULE_COST_WEIGHT=0.25
RISK_RULE_SCHEDULE_WEIGHT=0.25
RISK_RULE_MILESTONE_WEIGHT=0.15
RISK_RULE_EXPENDITURE_WEIGHT=0.10
RISK_COST_DOMAIN_COST_WEIGHT=0.60
RISK_COST_DOMAIN_PROGRESS_WEIGHT=0.20
RISK_COST_DOMAIN_SCHEDULE_WEIGHT=0.20
RISK_SCHEDULE_DOMAIN_SCHEDULE_WEIGHT=0.60
RISK_SCHEDULE_DOMAIN_MILESTONE_WEIGHT=0.30
RISK_SCHEDULE_DOMAIN_PROGRESS_WEIGHT=0.10
RISK_IMPLEMENTATION_DOMAIN_PROGRESS_WEIGHT=0.40
RISK_IMPLEMENTATION_DOMAIN_MILESTONE_WEIGHT=0.35
RISK_IMPLEMENTATION_DOMAIN_EXPENDITURE_WEIGHT=0.25
RISK_PROGRESS_GAP_SATURATION_PP=30
RISK_COST_OVERRUN_SATURATION_PCT=50
RISK_SCHEDULE_DELAY_SATURATION_DAYS=365
RISK_EXPENDITURE_GAP_SATURATION_PP=30
RISK_LEVEL_WATCH_THRESHOLD=35
RISK_LEVEL_HIGH_THRESHOLD=60
RISK_LEVEL_CRITICAL_THRESHOLD=80
RISK_DRIVER_MEDIUM_THRESHOLD=30
RISK_DRIVER_HIGH_THRESHOLD=60
RISK_STATISTICAL_MIN_PEER_COUNT=5
RISK_ML_COST_WEIGHT=0.50
RISK_ML_SCHEDULE_WEIGHT=0.50
RISK_TRAJECTORY_STABLE_BAND_POINTS=2
RISK_TRAJECTORY_MEANINGFUL_INCREASE_POINTS=5
RISK_TRAJECTORY_RAPID_INCREASE_POINTS=10
COMPARISON_SIGNIFICANT_RISK_INCREASE_POINTS=10

# Deterministic input-data confidence (server-side; weights must sum to 1.0).
DATA_CONFIDENCE_REQUIRED_FIELDS_WEIGHT=0.20
DATA_CONFIDENCE_FRESHNESS_WEIGHT=0.15
DATA_CONFIDENCE_HISTORY_WEIGHT=0.15
DATA_CONFIDENCE_MILESTONE_WEIGHT=0.10
DATA_CONFIDENCE_COST_WEIGHT=0.10
DATA_CONFIDENCE_PROGRESS_WEIGHT=0.10
DATA_CONFIDENCE_CLEARANCE_WEIGHT=0.05
DATA_CONFIDENCE_LAND_WEIGHT=0.05
DATA_CONFIDENCE_AGENCY_CONTRACT_WEIGHT=0.05
DATA_CONFIDENCE_VALIDATION_WEIGHT=0.05
DATA_CONFIDENCE_FRESH_DAYS=45
DATA_CONFIDENCE_STALE_DAYS=180
DATA_CONFIDENCE_HISTORY_TARGET_MONTHS=12
DATA_CONFIDENCE_ANOMALY_PENALTY=20
DATA_CONFIDENCE_VALIDATION_ISSUE_PENALTY=10

# Automated early-warning thresholds (server-authoritative).
WARNING_PROGRESS_VARIANCE_THRESHOLD_PP=10
WARNING_PROGRESS_VARIANCE_HIGH_PP=15
WARNING_PROGRESS_VARIANCE_CRITICAL_PP=25
WARNING_COST_ESCALATION_THRESHOLD_PCT=10
WARNING_COST_ESCALATION_HIGH_PCT=20
WARNING_COST_ESCALATION_CRITICAL_PCT=40
WARNING_EXPENDITURE_GAP_THRESHOLD_PP=10
WARNING_EXPENDITURE_GAP_HIGH_PP=20
WARNING_EXPENDITURE_GAP_CRITICAL_PP=30
WARNING_RISK_INCREASE_THRESHOLD_POINTS=10
WARNING_RISK_INCREASE_HIGH_POINTS=20
WARNING_RISK_INCREASE_CRITICAL_POINTS=30
WARNING_DELAY_PROBABILITY_THRESHOLD=0.65
WARNING_DELAY_PROBABILITY_HIGH=0.80
WARNING_DELAY_PROBABILITY_CRITICAL=0.90
WARNING_COST_PROBABILITY_THRESHOLD=0.65
WARNING_COST_PROBABILITY_HIGH=0.80
WARNING_COST_PROBABILITY_CRITICAL=0.90
WARNING_COMPLETION_REVISION_THRESHOLD_DAYS=30
WARNING_COMPLETION_REVISION_HIGH_DAYS=180
WARNING_COMPLETION_REVISION_CRITICAL_DAYS=365
WARNING_OVERDUE_MILESTONE_THRESHOLD_COUNT=1
WARNING_OVERDUE_MILESTONE_HIGH_COUNT=3
WARNING_OVERDUE_MILESTONE_CRITICAL_COUNT=5
WARNING_STAGNATION_CYCLES=3
WARNING_STAGNATION_HIGH_CYCLES=4
WARNING_STAGNATION_CRITICAL_CYCLES=6
WARNING_STAGNATION_EPSILON_PP=0.5
